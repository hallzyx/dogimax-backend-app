# Database Configuration
DB_URL=jdbc:mysql://localhost:33065/dogimax_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
JWT_EXPIRATION_DAYS=7

# CORS Configuration - Comma separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://your-production-domain.com

# Server Configuration
SERVER_PORT=8080